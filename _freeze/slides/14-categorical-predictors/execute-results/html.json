676782,8.7575757575757578,8.8383838383838391,8.9191919191919204,9],\"opacity\":0.80000000000000004,\"contours\":{\"z\":{\"show\":true,\"width\":2,\"highlightcolor\":\"#ff0000\",\"project\":{\"z\":true}},\"coloring\":\"heatmap\"},\"frame\":null}],\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n\n## Model Fit {.smaller}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n\n|term         |   estimate| std.error| statistic| p.value|\n|:------------|----------:|---------:|---------:|-------:|\n|(Intercept)  | -315.00522|  46.72441|  -6.74177| 0.00000|\n|Cards        |  -81.11569|  14.45641|  -5.61105| 0.00000|\n|Rating       |   14.83433|   0.11902| 124.64042| 0.00000|\n|Cards:Rating |    0.02376|   0.03598|   0.66030| 0.50945|\n\n\n:::\n:::\n\n\n$$\n\\begin{aligned}\\hat{\\text{Limit}} ~ =\n&  -315.005 + 14.834~\\text{Rating} -81.116~\\text{Cards}\\\\\n& \\qquad+ 0.024~\\text{Rating}\\times\\text{Cards}\n\\end{aligned}\n$$\n\n## Interpreting the interaction term\n\n-  For a fixed `Rating` the slope of `Cards` is $(-81.116 + 0.024\\times\\text{Rating})$\n-  For a fixed `Cards` the slope of `Rating` is $(14.834 + 0.024\\times\\text{Cards})$\n\n\n\n## What's actually happening: {.smaller}\n\n\n::: {.cell}\n\n```{.r .cell-code}\nCredit_int <- Credit |>\n  mutate(Interaction = Cards * Rating)\n\nCredit_int |>\n  select(Limit, Cards, Rating, Interaction) |>\n  head() |>\n  kable()\n```\n\n::: {.cell-output-display}\n\n\n| Limit| Cards| Rating| Interaction|\n|-----:|-----:|------:|-----------:|\n|  3606|     2|    283|         566|\n|  6645|     3|    483|        1449|\n|  7075|     4|    514|        2056|\n|  9504|     3|    681|        2043|\n|  4897|     2|    357|         714|\n|  8047|     4|    569|        2276|\n\n\n:::\n:::\n\n\n## What's actually happening:\n\n\n::: {.cell}\n\n```{.r .cell-code}\nlm(Limit ~ Cards + Rating + Interaction, data = Credit_int) |>\n  tidy() |>\n  kable(digits = 5)\n```\n\n::: {.cell-output-display}\n\n\n|term        |   estimate| std.error| statistic| p.value|\n|:-----------|----------:|---------:|---------:|-------:|\n|(Intercept) | -315.00522|  46.72441|  -6.74177| 0.00000|\n|Cards       |  -81.11569|  14.45641|  -5.61105| 0.00000|\n|Rating      |   14.83433|   0.11902| 124.64042| 0.00000|\n|Interaction |    0.02376|   0.03598|   0.66030| 0.50945|\n\n\n:::\n:::\n\n\n\n# Wrap up\n\n## Recap\n\n-   Introduced multiple linear regression\n\n-   Interpreted coefficients in the multiple linear regression model\n\n-   Calculated predictions and associated intervals for multiple linear regression models\n\n-   Introduced categorical variables\n\n-   Used interaction terms\n\n",
